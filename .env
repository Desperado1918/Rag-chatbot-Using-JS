# PageIndex API Key — get yours at https://dash.pageindex.ai
PAGEINDEX_API_KEY=01f8aa6fd0dd4ae0b5d3c8c651a72a3d

# Ollama Configuration (local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_CONTEXT_WINDOW=8192

# ChromaDB
CHROMA_URL=http://localhost:8000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/rag-chatbot

# Server
PORT=3000

# =============================================================================
# Authentication
# =============================================================================
JWT_SECRET=your-secret-key-change-me-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
BCRYPT_ROUNDS=12
MAX_FAILED_LOGINS_BEFORE_CAPTCHA=5
LOCKOUT_DURATION_MS=60000

# CAPTCHA (Google reCAPTCHA v3 — get keys at https://www.google.com/recaptcha)
# CAPTCHA_SECRET=your-recaptcha-secret-key
# CAPTCHA_VERIFY_URL=https://www.google.com/recaptcha/api/siteverify

# Email Verification (stub — configure SMTP/SendGrid later)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# VERIFY_EMAIL_FROM=noreply@yourdomain.com